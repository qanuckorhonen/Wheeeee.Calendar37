@using Wheeeee.Calendar37.Core.Interfaces
@model Tuple<IEnumerable<IEditablePerson>, IEnumerable<IPersonRole>>

@{
    var persons = Model.Item1?.ToArray() ?? Array.Empty<IEditablePerson>();
    var roles = Model.Item2?.ToArray() ?? Array.Empty<IPersonRole>();
}

<table class="participants-table">
    <thead>
        <tr>
            <th>Nr.</th>
            <th>Vorname</th>
            <th>Nachname</th>
            <th>Rollen</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < persons.Length; i++)
        {
            var p = persons[i];
            <tr>
                <td>@(i+1)</td>
                <td>@p.FirstName</td>
                <td>@p.LastName</td>
                <td>
                    @foreach (var r in roles)
                    {
                        if (p.RolesIDs != null && p.RolesIDs.Contains(r.ID))
                        {
                            <span class="role">@r.Name</span>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .participants-table { width:100%; border-collapse: collapse; }
    .participants-table th, .participants-table td { padding: .3rem .5rem; border: 1px solid var(--border, #ddd); vertical-align: middle; }
    .role { display:inline-block; background:#f5f5f5; padding:.1rem .4rem; margin-right:.25rem; border-radius:3px; }
</style>
