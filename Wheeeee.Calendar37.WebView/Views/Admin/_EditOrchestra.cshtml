@using Wheeeee.Calendar37.Core.Interfaces
@model IEditableOrchestra

<form id="editForm">
    <div class="tabs-vertical" data-tabs>
        <ul class="tab-list" role="tablist">
            <li><button type="button" class="tab-btn active" role="tab" data-target="v1">Allgemein</button></li>
            <li><button type="button" class="tab-btn" role="tab" data-target="v2">Rollen</button></li>
            <li><button type="button" class="tab-btn" role="tab" data-target="v3">Saisons</button></li>
            <li><button type="button" class="tab-btn" role="tab" data-target="v4">Termine</button></li>
            <li><button type="button" class="tab-btn" role="tab" data-target="v5">Instrumentierung</button></li>
            <li><button type="button" class="tab-btn" role="tab" data-target="v6">Mitwirkende</button></li>
        </ul>
        <div class="tab-panels">
            <div id="v1" class="tab-panel active" role="tabpanel">
                <div class="panel-content">
                    <h3>Allgemein</h3>
                    <partial name="_EditOrchestraGeneral" model="Model" />
                </div>
            </div>
            <div id="v2" class="tab-panel" role="tabpanel">
                <div class="panel-content">
                    <h3>Rollen</h3>
                    <partial name="_EditOrchestraRoles" model="Model.Roles" />
                </div>
            </div>
            <div id="v3" class="tab-panel" role="tabpanel">
                <div class="panel-content">
                    <partial name="_EditOrchestraSaisons" model="Model.Seasons" />
                </div>
            </div>
            <div id="v4" class="tab-panel" role="tabpanel">
                <div class="panel-content">
                    <strong>Termine</strong>
                </div>
            </div>
            <div id="v5" class="tab-panel" role="tabpanel">
                <div class="panel-content">
                    <h3>Instrumentierung</h3>
                    <partial name="_EditOrchestraInstrumentation" model="Model.Instruments" />
                </div>
            </div>
            <div id="v6" class="tab-panel" role="tabpanel">
                <div class="panel-content">
                    <h3>Mitwirkende</h3>
                    <partial name="_EditOrchestraParticipants" model="Model" />
                </div>
            </div>
        </div>
    </div>



    <button type="button" onclick="saveOrchestra('@Model.Id')">Save</button>
</form>

            
<script>
    // One generic handler for every [data-tabs] container
    document.querySelectorAll('[data-tabs]').forEach(container => {
      container.querySelectorAll('[role="tab"]').forEach(btn => {
        btn.addEventListener('click', () => {
          // Deactivate all in this container
          container.querySelectorAll('[role="tab"]').forEach(b => b.classList.remove('active'));
          container.querySelectorAll('[role="tabpanel"]').forEach(p => p.classList.remove('active'));

          // Activate clicked
          btn.classList.add('active');
          const target = document.getElementById(btn.dataset.target);
          if (target) target.classList.add('active');
        });
      });
    });
</script>

<script>
    function saveOrchestra(orchestraId) {
        const form = document.getElementById('editForm');
        const data = new FormData(form);
        fetch('/Admin/Save?orchestraId=' + encodeURIComponent(orchestraId), {
            method: 'POST',
            body: data
        }).then(r => {
            if (!r.ok) alert('Save failed');
        }).catch(e => alert('Save error'));
    }
</script>
